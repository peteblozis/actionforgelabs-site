{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "actionforgelabs-macie-sections",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "routes": [
    { "pattern": "actionforgelabs.com/test", "zone_name": "actionforgelabs.com" },
    { "pattern": "actionforgelabs.com/test/", "zone_name": "actionforgelabs.com" },
    { "pattern": "actionforgelabs.com/tester", "zone_name": "actionforgelabs.com" },
    { "pattern": "actionforgelabs.com/tester/", "zone_name": "actionforgelabs.com" },
    { "pattern": "actionforgelabs.com/lab", "zone_name": "actionforgelabs.com" },
    { "pattern": "actionforgelabs.com/lab/", "zone_name": "actionforgelabs.com" },
    { "pattern": "actionforgelabs.com/private", "zone_name": "actionforgelabs.com" },
    { "pattern": "actionforgelabs.com/private/", "zone_name": "actionforgelabs.com" }
  ]
}
